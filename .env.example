# AWS S3 Configuration for file uploads
# docker-compose の backend 既定は LocalStack S3（SERVICES に s3 を含む）。ホストで移行ツール等を動かすときは localhost を指定:
#   AWS_S3_ENDPOINT_URL=http://localhost:4566
# MinIO: コンテナ内からは http://minio:9000。ホストで migrate:legacy-crm 等を動かすときは公開ポートへ:
#   AWS_S3_ENDPOINT_URL=http://localhost:9000
# 本番 AWS S3: AWS_S3_ENDPOINT_URL は空にし、実リージョンの認証情報を設定

# AWS region (default: ap-northeast-1 for Japan)
AWS_REGION=ap-northeast-1

# S3 bucket name for file uploads（init-localstack.sh / MinIO と一致）
S3_BUCKET_NAME=redmine-uploads

# ホストから S3 互換へ接続するときは必ず localhost（Compose サービス名 minio / localstack はホストから解決不可）
# LocalStack を使う場合（backend 既定と揃える）:
AWS_S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# MinIO だけ使う場合の例（上の 3 行を差し替え）:
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Database configuration
# - ホストマシンで backend / 移行ツールを動かすとき: ホストは @db を解決できないので localhost + 公開ポートを使う
#   例: postgresql://redmine:redmine_password@localhost:5432/redmine_db
# - Docker Compose 内のコンテナ（app など）から繋ぐときのみ: サービス名 db が使える
#   例: postgresql://redmine:redmine_password@db:5432/redmine_db
# - legacy-crm 移行（npm run migrate:legacy-crm）はローカル（移行先）DB のみを対象にする。本番 PostgreSQL では移行 CLI を実行しない
DATABASE_URL=postgresql://redmine:redmine_password@localhost:5432/redmine_db

# JWT secret for authentication (change in production)
JWT_SECRET=dev-jwt-secret-change-in-production

# AWS SES Configuration for email sending
# Default sender email address
EMAIL_FROM=noreply@projecthub.local

# SMTP パスワードを DB に保存するときの暗号化キー（64 文字の hex 推奨）。未設定時は JWT_SECRET から導出
# EMAIL_ENCRYPTION_KEY=


# SES endpoint URL (only needed for LocalStack or mock services)
# For production AWS SES: leave empty
# For local development with LocalStack: http://localstack:4566
AWS_SES_ENDPOINT_URL=http://localstack:4566
