# =============================================================================
# ProjectHub 環境変数サンプル
# コピーして使う: cp .env.example .env
# Docker Compose はリポジトリルートの .env を変数展開に使います（backend へ渡す値）。
# 詳細（SSO）: doc/MICROSOFT_SSO.md
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# - ホストで backend / 移行ツールを動かすとき: localhost + 公開ポート
# - Compose 内の backend コンテナは docker-compose.yml 側で db ホストを指定（上書きされる）
# - legacy-crm 移行はローカル DB のみ。本番 PostgreSQL では移行 CLI を実行しない
DATABASE_URL=postgresql://redmine:redmine_password@localhost:5432/redmine_db

# -----------------------------------------------------------------------------
# Application / Auth（JWT）
# -----------------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-change-in-production
# NODE_ENV=development
# PORT=3000
# UPLOAD_DIR=
# TZ=Asia/Tokyo

# -----------------------------------------------------------------------------
# Microsoft 365 / Entra ID SSO（任意）
# 未設定または空のまま → パスワードログインのみ（Microsoft ボタン非表示）
# 利用時は TENANT_ID / CLIENT_ID / CLIENT_SECRET を必須で設定すること
# テナント ID はディレクトリ（テナント）ID。common / organizations / consumers は不可
# 手順: doc/MICROSOFT_SSO.md
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Entra アプリ登録の「リダイレクト URI（Web）」と完全一致させること
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# SSO 完了後・ユーザー作成案内メールのログイン URL 基点（末尾スラッシュなし）
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# AWS 共通
# -----------------------------------------------------------------------------
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# -----------------------------------------------------------------------------
# S3（ファイルアップロード）
# docker-compose の backend 既定は LocalStack S3。
# ホストから接続するときは localhost（Compose サービス名はホストから解決不可）
# 本番 AWS S3: AWS_S3_ENDPOINT_URL は空（または未設定）にし、実認証情報を設定
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=redmine-uploads
AWS_S3_ENDPOINT_URL=http://localhost:4566
# MinIO を使う場合の例:
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# Email（SES / 送信元）
# Compose 内 backend 向け LocalStack SES は http://localstack:4566
# ホストから SES モックを見る場合は http://localhost:4566
# 本番 AWS SES: AWS_SES_ENDPOINT_URL は未設定のまま
# -----------------------------------------------------------------------------
EMAIL_FROM=noreply@projecthub.local
AWS_SES_ENDPOINT_URL=http://localstack:4566
# SMTP パスワードを DB に保存するときの暗号化キー（64 文字の hex 推奨）。未設定時は JWT_SECRET から導出
# EMAIL_ENCRYPTION_KEY=
